# Krishi Mitra Backend Configuration
PROJECT_NAME="Krishi Mitra Agricultural Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# PostgreSQL + PostGIS Connection URL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krishi_mitra"
# Local SQLite fallback
DATABASE_URL="sqlite:///./storage/krishi_mitra.db"

# LLM & AI Keys (Optional - fallbacks active when unset)
GEMINI_API_KEY=""
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
OPENWEATHERMAP_API_KEY=""
SENTINEL_STAC_URL="https://earth-search.aws.element84.com/v1"

# Supported vernacular languages: hi (Hindi), te (Telugu), mr (Marathi), en (English)
DEFAULT_LANGUAGE="hi"

